#!/bin/sh
# Test the working tree without stashing or changing the index.
set -eu

started=$(date +%s)
cd "$(git rev-parse --show-toplevel)"

# Git pathspecs match these extensions at any depth. Include tooling changes too.
set -- '*.cs' '*.csproj' '*.sln*' 'Directory.Build.*' \
  ':(glob)**/Directory.Build.*' 'tests/**' '.githooks/**' 'scripts/**'

if git diff --cached --quiet -- "$@"; then
  printf '[pre-commit] No staged code/tooling changes; skipped (%ss).\n' "$(($(date +%s) - started))"
  exit 0
fi

if ! git diff --quiet -- "$@" ||
   [ -n "$(git ls-files --others --exclude-standard -- "$@")" ]; then
  printf '%s\n' '[pre-commit] WARNING: unstaged/untracked code or tooling exists. Testing the working tree; staged code may differ.' >&2
fi

if ! command -v dotnet >/dev/null 2>&1; then
  printf '%s\n' '[pre-commit] FAILED: dotnet is required (.NET 10 SDK and Windows for both test suites).' \
    '[pre-commit] Fix the failure and retry, or bypass with git commit --no-verify.' >&2
  printf '[pre-commit] Elapsed: %ss.\n' "$(($(date +%s) - started))" >&2
  exit 1
fi

log_dir=$(mktemp -d)
trap 'rm -rf "$log_dir"' 0
trap 'exit 130' INT
trap 'exit 143' TERM
failures=''

run_check() {
  label=$1
  shift
  printf '[pre-commit] %s...\n' "$label"
  if "$@" >"$log_dir/output" 2>&1; then
    printf '[pre-commit] %s: passed.\n' "$label"
  else
    failures="${failures}${failures:+, }$label"
    printf '[pre-commit] %s: FAILED (last 30 output lines).\n' "$label" >&2
    tail -n 30 "$log_dir/output" >&2
  fi
}

# Debug shares normal development outputs; keep restore enabled for fresh clones.
run_check 'Plugin build' dotnet build HopperGroup.csproj -c Debug --nologo -v quiet
run_check 'Regression tests' dotnet run --project tests/HopperGroup.RegressionTests -c Debug -v quiet
run_check 'Windows input tests' dotnet run --project tests/HopperGroup.WindowsInputTests -c Debug -v quiet

elapsed=$(($(date +%s) - started))
if [ -n "$failures" ]; then
  printf '[pre-commit] FAILED: %s (%ss).\n' "$failures" "$elapsed" >&2
  printf '%s\n' '[pre-commit] Fix the failures and retry, or bypass with git commit --no-verify.' >&2
  exit 1
fi
printf '[pre-commit] All checks passed (%ss).\n' "$elapsed"
